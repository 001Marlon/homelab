# Vorlage für homelab-secrets.yml
#
# Kopieren nach homelab-secrets.yml (Repo-Root) und die Platzhalter durch
# echte Werte ersetzen. homelab-secrets.yml selbst ist in .gitignore
# eingetragen und darf nie committed werden.
#
# - infrastructure/ansible/playbooks/render-terraform-vars.yml rendert daraus
#   infrastructure/proxmox/terraform/terraform.tfvars
# - infrastructure/ansible/roles/homelab/tasks/main.yml rendert daraus die
#   .env-Datei jeder App unter apps/<app>/.env

# ------ Terraform ------

terraform:

  # General
  ssh_public_keys: [
    "ssh-ed25519 AAAA... dein-erster-key",
    "ssh-ed25519 AAAA... dein-zweiter-key"
  ]

  proxmox_node_name: "homelab-pve01"
  default_gateway: "192.168.178.1"
  default_dns_server: "192.168.178.1"

  # Proxmox
  proxmox_endpoint: "https://192.168.178.200:8006/"
  proxmox_username: "root@pam"
  proxmox_password: "<Proxmox Passwort oder API-Token>"

  # TrueNAS Scale VM
  truenas_vm_id: 101
  truenas_vm_name: "homelab-truenas01"
  truenas_vm_ip: "192.168.178.201/24"
  truenas_iso_url: "https://download.sys.truenas.net/TrueNAS-SCALE-Goldeye/25.10.6/TrueNAS-SCALE-25.10.6.iso"
  truenas_hdd_ids: [
    "/dev/disk/by-id/<deine-erste-festplatten-id>",
    "/dev/disk/by-id/<deine-zweite-festplatten-id>"
  ]

  # Debian VM
  debian_vm_id: 102
  debian_vm_name: "homelab-debian01"
  debian_vm_ip: "192.168.178.202/24"
  debian_cloud_image_url: "https://cloud.debian.org/images/cloud/trixie/latest/debian-13-genericcloud-amd64.qcow2"


# ------ Homelab Apps ------
#
# Ein Block pro App-Ordner unter apps/. Der Key muss exakt dem Ordnernamen
# entsprechen (z. B. "arr-stack" für apps/arr-stack). Jeder Wert landet als
# KEY=VALUE-Zeile in apps/<app>/.env.

apps:

  # Netbird
  netbird:
    MANAGEMENT_URL: https://netbird.vps.example.com
    SETUP_KEY: "<Netbird Setup-Key>"

  # Glance
  glance:
    NETBIRD_BEARER_TOKEN: "<Netbird API Bearer Token>"

  # MkDocs
  mkdocs:
    MKDOCS_URL: https://docs.example.com

  # Paperless
  paperless:
    PAPERLESS_SECRET_KEY: "<langer, zufälliger String>"
    PAPERLESS_URL: https://paperless.example.com

  # Immich
  immich:
    DB_PASSWORD: "<Postgres Passwort>"
    UPLOAD_LOCATION: ./library
    DB_DATA_LOCATION: ./postgres

  # Arr-Stack
  arr-stack:
    PUID: 3000
    PGID: 3000
    UMASK: "002"
    TZ: Europe/Berlin
    CONFIG_ROOT: ./config
    MEDIA_ROOT: /homelab/data/media
    PROWLARR_PORT: 8105
    SONARR_PORT: 8107
    RADARR_PORT: 8106
    QBITTORRENT_PORT: 8103
    QBITTORRENT_TORRENT_PORT: 8104
    SABNZBD_PORT: 8102
    JELLYFIN_PORT: 8100
    JELLYSEERR_PORT: 8101
    FLARESOLVERR_PORT: 8108
    PROTONVPN_WIREGUARD_PRIVATE_KEY: "<ProtonVPN WireGuard Private Key>"
    PROTONVPN_WIREGUARD_ADDRESSES: "<ProtonVPN WireGuard Address, z.B. 10.2.0.2/32>"
    PROTONVPN_SERVER_COUNTRY: Switzerland
    DISCORD_WEBHOOK_URL: "<Discord Webhook URL>"

  # Arcane
  arcane:
    ENCRYPTION_KEY: "<zufälliger Hex-String>"
    JWT_SECRET: "<zufälliger Hex-String>"

  # Beszel
  beszel:
    BESZEL_URL: https://beszel.example.com
    TOKEN: "<Beszel Hub Token>"
    KEY: "<Beszel SSH Public Key>"
