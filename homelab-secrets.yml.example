# Vorlage für homelab-secrets.yml
#
# Kopieren nach homelab-secrets.yml (Repo-Root) und die Platzhalter durch
# echte Werte ersetzen. homelab-secrets.yml selbst ist in .gitignore
# eingetragen und darf nie committed werden.
#
# - infrastructure/ansible/playbooks/sync-reverse-proxy.yml rendert daraus
#   die öffentlichen NetBird-Reverse-Proxy-Services
# - infrastructure/ansible/playbooks/render-terraform-vars.yml rendert daraus
#   infrastructure/proxmox/terraform/terraform.tfvars
# - infrastructure/ansible/roles/homelab/tasks/main.yml rendert daraus die
#   .env-Datei jeder App unter apps/<app>/.env

# ------ NetBird Reverse Proxy ------
#
# Steuert infrastructure/ansible/playbooks/sync-reverse-proxy.yml: legt für
# jede App unten einen öffentlichen NetBird-Reverse-Proxy-Service an,
# aktualisiert bestehende bei jedem Lauf auf diesen Stand und löscht Services,
# die aus der Liste entfernt wurden. Apps mit sensiblen Admin-/Download-
# Oberflächen (z. B. qBittorrent, SABnzbd, Prowlarr, Sonarr, Radarr,
# FlareSolverr) bewusst NICHT eintragen - die bleiben VPN-only erreichbar.

netbird_reverse_proxy:
  api_url: https://netbird.vps.example.com/api
  api_token: "<NetBird Service-User Personal Access Token>"
  docker_host_peer_id: "<NetBird Peer-ID des Docker-Hosts>"
  docker_host_peer_ip: "<NetBird-IP des Docker-Hosts, z. B. 100.x.x.x>"

  # Gemeinsames Zusatz-Passwort vor allen unten gelisteten Services,
  # zusätzlich zum jeweiligen App-Login. Pro Service mit
  # "password_protected: false" abschaltbar (z. B. wenn die App ihr
  # eigenes starkes Auth mitbringt und der Zusatz-Prompt stört).
  shared_password: "<zufälliges Passwort>"

  services:
    - domain: glance.example.com
      port: 8000
      # password_protected: false
    - domain: docs.example.com
      port: 8001
    - domain: arcane.example.com
      port: 8002
    - domain: uptime.example.com
      port: 8003
    - domain: mcsmanager.example.com
      port: 8004
    - domain: paperless.example.com
      port: 8006
    - domain: immich.example.com
      port: 8007
    - domain: beszel.example.com
      port: 8009
    - domain: jellyfin.example.com
      port: 8100
    - domain: seerr.example.com
      port: 8101


# ------ Terraform ------

terraform:

  # General
  ssh_public_keys: [
    "ssh-ed25519 AAAA... dein-erster-key",
    "ssh-ed25519 AAAA... dein-zweiter-key"
  ]

  proxmox_node_name: "homelab-pve01"
  default_gateway: "192.168.178.1"
  default_dns_server: "192.168.178.1"

  # Proxmox
  proxmox_endpoint: "https://192.168.178.200:8006/"
  proxmox_username: "root@pam"
  proxmox_password: "<Proxmox Passwort oder API-Token>"

  # TrueNAS Scale VM
  truenas_vm_id: 101
  truenas_vm_name: "homelab-truenas01"
  truenas_vm_ip: "192.168.178.201/24"
  truenas_iso_url: "https://download.sys.truenas.net/TrueNAS-SCALE-Goldeye/25.10.6/TrueNAS-SCALE-25.10.6.iso"
  truenas_hdd_ids: [
    "/dev/disk/by-id/<deine-erste-festplatten-id>",
    "/dev/disk/by-id/<deine-zweite-festplatten-id>"
  ]

  # Debian VM
  debian_vm_id: 102
  debian_vm_name: "homelab-debian01"
  debian_vm_ip: "192.168.178.202/24"
  debian_cloud_image_url: "https://cloud.debian.org/images/cloud/trixie/latest/debian-13-genericcloud-amd64.qcow2"


# ------ Homelab Apps ------
#
# Ein Block pro App-Ordner unter apps/. Der Key muss exakt dem Ordnernamen
# entsprechen (z. B. "arr-stack" für apps/arr-stack). Jeder Wert landet als
# KEY=VALUE-Zeile in apps/<app>/.env. Werte auf "null" sind optionale
# Integrationen, die noch nicht eingerichtet sind (rendern als leerer Wert,
# nicht als Fehler).

apps:

  # Netbird
  netbird:
    MANAGEMENT_URL: https://netbird.vps.example.com
    SETUP_KEY: "<Netbird Setup-Key>"

  # Glance
  glance:
    NETBIRD_BEARER_TOKEN: "<Netbird API Bearer Token>"
    IMMICH_URL: https://immich.example.com
    IMMICH_API_KEY: null
    PAPERLESS_URL: https://paperless.example.com
    PAPERLESS_KEY: null
    JELLYFIN_URL: https://jellyfin.example.com
    JELLYFIN_API_KEY: null
    BESZEL_URL: https://beszel.example.com
    BESZEL_API_KEY: null
    VAULTWARDEN_URL: null
    UPTIME_KUMA_URL: null
    PORTAINER_URL: null
    MKDOCS_URL: https://docs.example.com
    VIKUNJA_URL: null
    VIKUNJA_API_TOKEN: null

  # MkDocs
  mkdocs:
    MKDOCS_URL: https://docs.example.com

  # Paperless
  paperless:
    PAPERLESS_SECRET_KEY: "<langer, zufälliger String>"
    PAPERLESS_URL: https://paperless.example.com

  # Immich
  immich:
    DB_PASSWORD: "<Postgres Passwort>"
    UPLOAD_LOCATION: ./library
    DB_DATA_LOCATION: ./postgres

  # Arr-Stack
  arr-stack:
    PUID: 3000
    PGID: 3000
    UMASK: "002"
    TZ: Europe/Berlin
    CONFIG_ROOT: ./config
    MEDIA_ROOT: /homelab/data/media
    PROWLARR_PORT: 8105
    SONARR_PORT: 8107
    RADARR_PORT: 8106
    QBITTORRENT_PORT: 8103
    QBITTORRENT_TORRENT_PORT: 8104
    SABNZBD_PORT: 8102
    JELLYFIN_PORT: 8100
    JELLYSEERR_PORT: 8101
    FLARESOLVERR_PORT: 8108
    PROTONVPN_WIREGUARD_PRIVATE_KEY: "<ProtonVPN WireGuard Private Key>"
    PROTONVPN_WIREGUARD_ADDRESSES: "<ProtonVPN WireGuard Address, z.B. 10.2.0.2/32>"
    PROTONVPN_SERVER_COUNTRY: Switzerland
    DISCORD_WEBHOOK_URL: "<Discord Webhook URL>"
    IMMICH_URL: https://immich.example.com

  # Arcane
  arcane:
    ENCRYPTION_KEY: "<zufälliger Hex-String>"
    JWT_SECRET: "<zufälliger Hex-String>"

  # Beszel
  beszel:
    BESZEL_URL: https://beszel.example.com
    TOKEN: "<Beszel Hub Token>"
    KEY: "<Beszel SSH Public Key>"
